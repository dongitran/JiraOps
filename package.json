{
  "name": "jira-ops",
  "displayName": "JiraOps",
  "description": "Assigned Jira tickets and GitLab merge request context in VS Code.",
  "version": "0.1.28",
  "publisher": "dongtran",
  "license": "MIT",
  "icon": "resources/jira-ops.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dongitran/JiraOps"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:jiraOps.linksView",
    "onCommand:jiraOps.openLinksView",
    "onCommand:jiraOps.openSettings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jiraOps.openLinksView",
        "title": "Open Dashboard",
        "category": "JiraOps"
      },
      {
        "command": "jiraOps.connectJira",
        "title": "Connect Jira",
        "category": "JiraOps"
      },
      {
        "command": "jiraOps.disconnectJira",
        "title": "Disconnect Jira",
        "category": "JiraOps"
      },
      {
        "command": "jiraOps.openSettings",
        "title": "Open Settings",
        "category": "JiraOps",
        "icon": "$(gear)"
      },
      {
        "command": "jiraOps.clearJiraCredentials",
        "title": "Clear Saved Jira OAuth Credentials",
        "category": "JiraOps"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jiraOps",
          "title": "JiraOps",
          "icon": "resources/jira-ops.svg"
        }
      ]
    },
    "views": {
      "jiraOps": [
        {
          "id": "jiraOps.linksView",
          "name": "JiraOps",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "jiraOps.openLinksView"
        },
        {
          "command": "jiraOps.connectJira"
        },
        {
          "command": "jiraOps.disconnectJira"
        },
        {
          "command": "jiraOps.openSettings"
        },
        {
          "command": "jiraOps.clearJiraCredentials"
        }
      ],
      "view/title": [
        {
          "command": "jiraOps.openSettings",
          "when": "view == jiraOps.linksView",
          "group": "navigation@0"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "cspell": "cspell \"**/*\" --no-progress --no-must-find-files --gitignore",
    "test:unit": "vitest run --coverage",
    "validate:root": "npm run typecheck && npm run lint && npm run cspell && npm run test:unit",
    "validate:e2e": "npm --prefix e2e run validate",
    "validate": "npm run validate:root && npm run validate:e2e",
    "precommit": "npm run validate",
    "package": "vsce package --no-dependencies",
    "package:pre": "vsce package --pre-release --no-dependencies",
    "publish": "vsce publish --skip-duplicate --no-dependencies",
    "publish:pre": "vsce publish --pre-release --skip-duplicate --no-dependencies",
    "vscode:prepublish": "npm run build",
    "prepare": "node ./scripts/setup-husky.cjs"
  },
  "dependencies": {
    "@saptools/gitport": "^0.1.11",
    "jira-oauth-client": "^0.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.1",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^3.1.1",
    "@vscode/vsce": "^3.6.3",
    "cspell": "^8.17.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  }
}
